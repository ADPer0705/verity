# --- secrets
.env
.env.*
!.env.example

# --- python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- node (UI)
src/verity_ui/node_modules/
src/verity_ui/dist/
src/verity_ui/tsconfig.tsbuildinfo

# --- runtime data: ingested media, per-run artifacts, reports
workspace/
workspace-*/
input/
output/

# --- per-detector uv environments (provisioned on demand, see VERITY_DETECTOR_ENVS)
.detectorenvs/

# --- model checkpoints (fetched with `verity weights pull`; never committed)
detectors/*/weights/*
!detectors/*/weights/README.md

# --- release artifacts
dist-bundle/
dist-weights/

# --- non-project reference material (vendored DeepfakeBench checkout, sample media)
misc/

# --- editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
