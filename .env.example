# Copy to .env (never committed). Everything is optional: Verity runs fully
# offline with sensible defaults once checkpoints and environments exist.

# --- container runtime (read by docker-compose.yml)
VERITY_IMAGE=ghcr.io/adper0705/verity:slim
VERITY_BIND=127.0.0.1                   # loopback by default; API has no auth

# --- paths (relative paths resolve against the repo root for the server, the cwd for the CLI)
VERITY_WORKSPACE=workspace
VERITY_OUTPUT_DIR=workspace/output
VERITY_DETECTORS_DIR=detectors
VERITY_DETECTOR_ENVS=.detectorenvs      # per-detector uv environments
VERITY_WEIGHTS_ROOT=                    # empty: checkpoints stay in detectors/<id>/weights/

# --- hardware / selection
VERITY_HW_PROFILE=auto                  # auto | cuda | cpu
VERITY_INCLUDE_UNTRAINED=               # 1: auto-select untrained-head detectors too (research only)
VERITY_OFFLINE=                         # 1: never download anything (weights, HF models)
VERITY_DETECTOR_TIMEOUT=3600            # seconds per detector subprocess

# --- checkpoints
VERITY_WEIGHTS_HUB=                     # Hugging Face repo mirroring the checkpoints, e.g. ADPer0705/verity-weights
VERITY_WEIGHTS_AUTO=1                   # container only: fetch missing trained checkpoints on start

# --- server
VERITY_HOST=127.0.0.1
VERITY_PORT=8000
VERITY_CORS_ORIGINS=                    # comma-separated, dev only
